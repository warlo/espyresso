[Unit]
Description=Espyresso
After=pigpiod.service
Requires=pigpiod.service

[Service]
User=root
WorkingDirectory=/home/pi/espyresso
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/sleep 2
# Outputs off before every start and after every stop, including crashes and
# kill -9: pigpiod keeps the element's hardware PWM running after the app dies.
ExecStartPre=/usr/bin/python3 -m espyresso.failsafe
ExecStart=/usr/bin/python3 -m espyresso
ExecStopPost=/usr/bin/python3 -m espyresso.failsafe
# The app reports READY after its first control tick and pings the watchdog
# only while control is healthy, so a hung or stalled app is restarted.
Type=notify
NotifyAccess=main
WatchdogSec=15
TimeoutStartSec=120
# A clean stop takes a few seconds; don't wait 90 s on a stuck one.
TimeoutStopSec=20
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
